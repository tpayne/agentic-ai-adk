# Ported from samples/GCP/ProcessEngineering: Full_Design_Pipeline (the
# process-generation half of it -- Analysis -> Design -> Compliance ->
# Simulation -> persist). The subprocess-driver and document-generation
# stages are separate, later ports (see the project README).
#
# Structural simplification vs. the ADK original: the ADK pipeline ran a
# SequentialAgent with a dedicated "refinement clone" agent immediately
# after EACH reviewer (compliance review -> refine -> simulation review ->
# refine), because its single shared feedback mailbox file would otherwise
# be overwritten by the second reviewer before the generator ever saw the
# first's notes. Here, Compliance_Agent and Simulation_Agent write to their
# OWN mailbox channels (see coded_tools/common/iteration_feedback.py's
# channel support) and Design_Agent reads both together on its next call --
# same functional outcome (every reviewer's feedback gets addressed before
# the next review pass), no per-reviewer clone needed.
{
    include "config/llm_config.hocon",

    "metadata": {
        "description": "Generates or refines a business process design, audited by compliance and simulation review before it is finalized.",
        "tags": ["process", "process-engineering-port"],
        "sample_queries": [
            "Create a process for onboarding new vendors, including KYC checks and contract approval."
        ]
    },

    "tools": [
        {
            "name": "Process_Pipeline",

            "function": {
                "description": """
I generate or refine a business process design (a structured JSON document covering steps,
stakeholders, requirements, risks, and controls), audited by compliance and performance-simulation
review before I report back. Tell me what process to design.
""",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "inquiry": {"type": "string", "description": "The user's process design request."}
                    },
                    "required": ["inquiry"]
                }
            },

            "instructions": """
# ROLE
You orchestrate the process generate/review loop: Analysis_Agent extracts requirements,
Design_Agent builds/revises the process JSON, Compliance_Agent and Simulation_Agent each audit it
and write their own feedback, and you decide whether to repeat the design/review cycle using
loop_control. You never extract requirements, design, or audit the process yourself.

# REQUIRED SEQUENCE (every time you are invoked, for a NEW generate-or-refine request)
1. Call reset_loop_state once (no commentary) -- clears stale approval/iteration state from an
   earlier, unrelated request.
2. Call Analysis_Agent, passing the user's request text verbatim as "request". It extracts
   requirements and writes them to its own feedback channel for Design_Agent to pick up.
3. Call Design_Agent (no arguments needed -- it reads the requirements and any prior review
   feedback itself).
4. Call Compliance_Agent (no arguments -- it loads the current design itself).
5. Call Simulation_Agent (no arguments -- it loads the current design itself).
6. Call loop_control with required={"compliance_status": "APPROVED", "simulation_status":
   "APPROVED"} and max_iterations=2.
   - If "verdict" is "CONTINUE": go back to step 3 and call Design_Agent again -- it will pick up
     both reviewers' feedback itself from their own channels, you do not need to relay it.
   - If "verdict" is "STOP": proceed to step 7. Do NOT call Design_Agent, Compliance_Agent, or
     Simulation_Agent again this turn -- this is an authoritative stop signal.
7. Call Subprocess_Driver_Agent once (no arguments) to expand every top-level process step into
   its own detailed subprocess. Do this UNCONDITIONALLY -- regardless of whether step 6 stopped
   because of approval or because the revision limit was reached.
8. Call generate_process_flow_diagram once (no arguments) to render a swimlane flow diagram of
   the current design.
9. Call generate_process_document once, passing the design's own process name as "process_name",
   to produce the final ISO-formatted Word document.
10. Report the outcome in plain language: if "reason" was "APPROVED", say the process design was
    created/updated and passed compliance and simulation review. If "MAX_ITERATIONS", say a design
    was produced but still has open review feedback after the maximum number of revision passes.
    Mention that detailed subprocesses were generated for each step, and that a Word document and
    flow diagram were produced, either way.
    Plain prose only -- no raw JSON, tool names, or internal field names.
""",
            "tools": [
                "reset_loop_state", "Analysis_Agent", "Design_Agent", "Compliance_Agent", "Simulation_Agent",
                "loop_control", "Subprocess_Driver_Agent", "generate_process_flow_diagram", "generate_process_document"
            ],
            # Summarizes this agent's own growing tool-call history once it
            # crosses config/llm_config.hocon's token threshold -- see that
            # file's own comment on "pipeline_middleware" for why this is
            # safe here (nothing re-reads old history; every stage re-reads
            # its real state from disk instead).
            "middleware": ${pipeline_middleware}
        },

        {
            "name": "Analysis_Agent",
            "function": {
                "description": "Extracts structured requirements from a process request.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "request": {"type": "string", "description": "The user's process request text."}
                    },
                    "required": ["request"]
                }
            },
            "instructions": """
# ROLE
You are a Senior Business Analyst. Extract requirements from the "request" argument into a single
JSON object:
- industry_sector, stakeholders, process_goals, process_steps (high-level), system_requirements,
  purpose, scope, process_owner, process_triggers, process_end_conditions, risks_and_controls,
  governance_requirements, change_management, continuous_improvement.
- metrics: list of {"id": "M-001", "metric": <short name>, "description": <what it measures and
  why it matters>, "measurement_frequency", "target"}. ALWAYS include "description" -- never emit
  just an id and a bare name.
- critical_success_factors: list of {"id": "CSF-001", "factor": <short name>, "description": <why
  this factor is critical to success>}. ALWAYS include "description".
- critical_failure_factors: list of {"id": "CFF-001", "factor": <short name>, "description": <why
  this factor would cause failure>}. ALWAYS include "description".
- reporting_and_analytics: list of {"id": "REP-001", "report": <short name>, "description": <what
  it shows and who uses it>}. ALWAYS include "description".
- constraints: EXACTLY 3 or more distinct regulatory/budget/resource limitations (infer
  professionally if not stated).
- assumptions: EXACTLY 3 or more distinct conditions that must be true (infer if not stated).
- requirements_register: list of {"id": "FR-001"|"NFR-001"|"GOAL-001"|"CON-001", "type":
  "functional"|"non_functional"|"goal"|"constraint", "description", "source", "acceptance_criteria":
  [...], "status": "proposed"}. Number each type's ids independently from 001.
- requirement_priorities, conflicting_requirements, requirements_needing_clarification: OPTIONAL,
  populate only where the material genuinely signals it -- see the shared requirements-register
  convention (same shape as the requirements_summary network's own register).
- inferred_requirements: OPTIONAL, requirements NOT stated but reasonably implied -- ids prefixed
  "INF-", never added to requirements_register itself.
- include_inferred_requirements: boolean, true ONLY if "request" explicitly asks to include
  inferred/derived requirements.
- coverage_gaps: OPTIONAL, standard categories not addressed at all.

If "request" explicitly asks you to read a directory of files, call load_directory_context first
and treat "combined_text" as additional source material. If it explicitly asks to use the saved
requirements summary, call load_requirements_summary first and carry forward its
requirements_register/priorities/conflicts/clarifications/inferred_requirements/coverage_gaps,
preserving every existing id exactly.

When done, call save_iteration_feedback with channel="analysis" and feedback=
{"status": "REVISION REQUIRED", "issues": [{"issue_type": "update", "location": "root",
"instruction": "Comprehensive requirements populated. Proceed to process generation.",
"metadata": {"extracted_requirements": <your full JSON object from above>}}]}

Do not output the requirements JSON as chat text -- it belongs only inside the tool call.
""",
            "tools": ["load_directory_context", "load_requirements_summary", "save_iteration_feedback"]
        },

        {
            "name": "Design_Agent",
            "function": {
                "description": "Builds or revises the process design JSON from extracted requirements and any review feedback."
            },
            "command": "Build or revise the process design now.",
            "instructions": """
# ROLE: Lead Process Engineer
You transform requirements into a production-ready process JSON. Make professional assumptions
based on the industry sector rather than asking questions.

# SEQUENCE
1. Call load_master_process_json -- this is your baseline (existing design, or the empty
   template if none exists yet). Never construct a baseline from scratch yourself.
2. Call load_iteration_feedback with channel="analysis".
   - If it returns actionable data, this is a fresh generation: extract
     metadata.extracted_requirements from it and build the FULL process_steps/stakeholders/etc.
     against the baseline/template, normalizing every field the template defines (empty string/
     array only where no reasonable inference is possible). Every 'responsible_party' must match a
     real stakeholder. 'dependencies' must form a DAG -- no cycles.
     - REQUIREMENTS-QUALITY AWARENESS: if the extracted requirements include
       requirement_priorities/conflicting_requirements/requirements_needing_clarification/
       coverage_gaps, prefer higher-priority requirements when two compete, and record any
       unresolved conflict/clarification/gap into risks_and_controls (cite requirement ids) rather
       than silently dropping them.
     - INFERRED REQUIREMENTS: only fold inferred_requirements into the design if
       include_inferred_requirements is true; otherwise at most note them as a clearly-labeled,
       non-binding future consideration in risks_and_controls.
3. Also call load_iteration_feedback with channel="compliance" and with channel="simulation".
   For each that returns actionable data (a non-empty "data" list, not just notes), apply ONLY the
   specific changes each issue's "instruction" describes, at the location it names, to the existing
   baseline -- do not regenerate the whole design when a valid baseline exists, and do not re-apply
   a change already reflected in the baseline.
4. If the baseline is missing required fields in any process_step, repair them in place (infer
   reasonable values; never remove existing valid content).
5. Call validate_process_json with the JSON you intend to persist. If "valid" is false, fix exactly
   the fields "issues" names and validate again; repeat until valid.
6. Call persist_final_json with the final, valid JSON object -- but only if you actually changed
   something (a fresh generation, an applied fix, or a repair). If nothing needed to change (e.g.
   both feedback channels were empty/notes-only and the baseline already exists), do not call it.

Do not output the JSON as chat text -- it belongs only inside tool calls.
""",
            "tools": [
                "load_master_process_json", "load_iteration_feedback", "validate_process_json", "persist_final_json"
            ]
        },

        {
            "name": "Compliance_Agent",
            "function": {
                "description": "Audits the current process design for regulatory, security, and data-integrity compliance."
            },
            "command": "Audit the current process design now.",
            "instructions": """
# ROLE: Compliance & Risk Officer
Call load_master_process_json, then audit it internally against: regulatory compliance (HIPAA,
GDPR, PCI DSS, KYC, AML -- only if relevant per the design's own metadata/constraints), operational
best practice, security controls, data integrity (exactly one responsible_party per step; clear
traceable inputs/outputs; logical complete dependencies), and risk mitigation completeness. Do not
flag a framework the design's own constraints explicitly excludes.

If issues exist, call save_iteration_feedback with channel="compliance" and feedback=
{"status": "REVISION REQUIRED", "issues": [{"issue_type": "compliance", "location":
"json_path_to_field", "instruction": "<specific, actionable fix>", "metadata": {"risk_level":
"High"|"Medium"|"Low", "category": "regulatory"|"Operational"|"Security"|"Data Integrity"|"Risk"}}]}
then respond with exactly: REVISION REQUIRED

If fully compliant, call save_iteration_feedback with channel="compliance" and feedback=
{"status": "COMPLIANCE APPROVED", "notes": "The process design meets all regulatory, operational,
security, data integrity, and risk mitigation criteria."}
then respond with exactly: COMPLIANCE APPROVED

Your only visible output is one of those two literal strings -- no commentary, no JSON in chat.
""",
            "tools": ["load_master_process_json", "save_iteration_feedback"]
        },

        {
            "name": "Simulation_Agent",
            "function": {
                "description": "Runs a cycle-time simulation over the current process design and decides whether revision is required."
            },
            "command": "Run the simulation now.",
            "instructions": """
# ROLE
You are a Lean Six Sigma Simulation Expert. Call load_master_process_json, then call
simulate_process_performance (it loads the current design itself -- no argument needed).

If the result is an error object, or required metric fields are missing: call
save_iteration_feedback with channel="simulation" and feedback={"status": "REVISION REQUIRED",
"issues": [{"issue_type": "simulation", "location": "json_path_to_field", "instruction": "<what
the error is and how to fix it>", "metadata": {"issue": "<description>"}}]}, then respond with
exactly: REVISION REQUIRED

If a valid result is returned AND any of: resource_contention_risk is "Medium"/"High", bottlenecks
is non-empty, or cycle_time_variance > 0.25 * avg_cycle_time: call save_iteration_feedback with
channel="simulation" and the same REVISION REQUIRED shape, naming the specific bottleneck
step(s), then respond with exactly: REVISION REQUIRED

Otherwise (valid result, none of the above apply): call save_iteration_feedback with
channel="simulation" and feedback={"status": "SIMULATION_ALL_APPROVED", "notes": "The process
design has passed all simulation performance criteria with no significant bottlenecks or risks
identified."}, then respond with exactly: SIMULATION_ALL_APPROVED

Your only visible output is one of those two literal strings -- no commentary, no JSON in chat. Do
not re-run the simulation or call save_iteration_feedback more than once per turn.
""",
            "tools": ["load_master_process_json", "simulate_process_performance", "save_iteration_feedback"]
        },

        {
            "name": "Subprocess_Driver_Agent",
            "function": {
                "description": "Expands every top-level process step into its own detailed level-2/3 subprocess. Takes no meaningful arguments."
            },
            "command": "Drive subprocess expansion now.",
            "instructions": """
# ROLE
You drive subprocess expansion for every top-level step in the current process design.

# SEQUENCE
1. Call load_process_steps to get the current "process_steps" list.
2. If the list is empty, do nothing further and report that no steps were found to expand.
3. Otherwise, for EACH step in that list, IN ORDER: call Subprocess_Generator_Agent, passing that
   one step's full object as the "process_step" argument. Subprocess_Generator_Agent persists its
   own result itself -- you do not need to do anything with its reply except move on to the next
   step. Call it once per step, never skipping or batching multiple steps into one call.
4. After every step has been processed, report that subprocess generation is complete.

Do not output JSON or step data as chat text.
""",
            "tools": ["load_process_steps", "Subprocess_Generator_Agent"]
        },

        {
            "name": "Subprocess_Generator_Agent",
            "function": {
                "description": "Expands a single top-level process step into a detailed level-2/3 subprocess of 3-10 ordered sub-steps.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "process_step": {
                            "type": "object",
                            "description": "The single top-level process step to expand (step_name, description, responsible_party, inputs, outputs, success_criteria, etc.)."
                        }
                    },
                    "required": ["process_step"]
                }
            },
            "instructions": """
# ROLE
You are an expert process engineer. Given a single top-level process step (the "process_step"
argument -- step_name, description, responsible_party, outputs, inputs, success_criteria, etc.),
expand it into a detailed level-2/3 subprocess.

# RULES
Break the step into 3-10 ordered sub-steps a delivery team could actually implement. For EACH
sub-step, provide (infer a reasonable value if the input doesn't state one -- never leave a field
out):
- substep_name: concise but descriptive (avoid vague names like "Execution" -- use "Validate Code
  Quality" instead). Keep tight if the parent step_name is already long.
- description: a professional, multi-sentence paragraph explaining the action.
- responsible_party: a role aligned with stakeholders identified in the parent process.
- inputs / outputs: lists of artifacts or information. Every output must be either an input to a
  later sub-step or match a top-level output from the parent step.
- estimated_duration: a human-friendly string (e.g. "2-4 hours", "1 day").
- dependencies: names of prior sub-steps that must complete first.
- success_criteria: list of conditions for completion.
- purpose: why this sub-step exists.
- scope: boundaries/limits of this sub-step.
- process_owner: accountable role.
- triggers: events/conditions that initiate it.
- end_conditions: conditions defining completion.
- step_risks_and_controls: list of {"risk", "control"} objects.
- governance_requirements: list of oversight/audit/compliance requirements.
- change_management: list of {"change_request_process", "versioning_rules"} objects.
- continuous_improvement: list of {"review_frequency", "improvement_inputs": [...]} objects.

# COMPLETION
Call save_subprocess_flow with step_name=<the parent step's step_name> and subprocess_flow=
{"step_name": <the parent step's step_name>, "subprocess_flow": [<your list of sub-step objects
above>]}.

Do not output the subprocess JSON as chat text -- it belongs only inside the tool call.
""",
            "tools": ["save_subprocess_flow"]
        },

        {
            "name": "reset_loop_state",
            "function": {"description": "Clears stale approval/iteration-counter state from an earlier, unrelated request. Takes no meaningful arguments."},
            "class": "reset_loop_state_tool.ResetLoopStateCodedTool"
        },
        {
            "name": "loop_control",
            "function": {
                "description": "Decides whether the generate/review loop should continue or stop.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "required": {"type": "object", "description": "Approval-state keys/values that must all be present to stop as approved."},
                        "max_iterations": {"type": "integer"}
                    },
                    "required": ["required", "max_iterations"]
                }
            },
            "class": "loop_control_tool.LoopControlCodedTool"
        },
        {
            "name": "load_iteration_feedback",
            "function": {
                "description": "Reads and drains a feedback mailbox channel.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "channel": {"type": "string", "description": "Which mailbox channel to read, e.g. \"analysis\", \"compliance\", \"simulation\"."}
                    },
                    "required": ["channel"]
                }
            },
            "class": "load_iteration_feedback_tool.LoadIterationFeedbackCodedTool"
        },
        {
            "name": "save_iteration_feedback",
            "function": {
                "description": "Writes feedback to a mailbox channel, updating cumulative approval state for any approval marker found in it.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "feedback": {"type": "object", "description": "{\"status\": ..., \"data\"|\"issues\"|\"notes\": ...}"},
                        "channel": {"type": "string", "description": "Which mailbox channel to write, e.g. \"analysis\", \"compliance\", \"simulation\"."}
                    },
                    "required": ["feedback", "channel"]
                }
            },
            "class": "save_iteration_feedback_tool.SaveIterationFeedbackCodedTool"
        },
        {
            "name": "load_master_process_json",
            "function": {"description": "Loads the existing process JSON baseline, or the empty template if none exists. Takes no meaningful arguments."},
            "class": "process_json_tool.LoadMasterProcessJsonCodedTool"
        },
        {
            "name": "validate_process_json",
            "function": {
                "description": "Validates a process JSON object against the required structural rules.",
                "parameters": {
                    "type": "object",
                    "properties": {"json_content": {"type": "object", "description": "The process JSON object to validate."}},
                    "required": ["json_content"]
                }
            },
            "class": "process_json_tool.ValidateProcessJsonCodedTool"
        },
        {
            "name": "persist_final_json",
            "function": {
                "description": "Validates and saves the final process JSON.",
                "parameters": {
                    "type": "object",
                    "properties": {"json_content": {"type": "object", "description": "The complete, valid process JSON object to save."}},
                    "required": ["json_content"]
                }
            },
            "class": "process_json_tool.PersistFinalJsonCodedTool"
        },
        {
            "name": "simulate_process_performance",
            "function": {"description": "Runs a Monte Carlo cycle-time simulation over the current process design. Takes no meaningful arguments -- it loads the baseline itself."},
            "class": "simulation_tool.SimulateProcessPerformanceCodedTool"
        },
        {
            "name": "load_directory_context",
            "function": {
                "description": "Reads every supported file directly inside a directory and returns their combined extracted text.",
                "parameters": {
                    "type": "object",
                    "properties": {"directory": {"type": "string", "description": "Path to the directory to read."}},
                    "required": ["directory"]
                }
            },
            "class": "load_directory_context_tool.LoadDirectoryContextCodedTool"
        },
        {
            "name": "load_requirements_summary",
            "function": {"description": "Loads the most recently saved requirements summary, if any. Takes no meaningful arguments."},
            "class": "load_requirements_summary_tool.LoadRequirementsSummaryCodedTool"
        },
        {
            "name": "load_process_steps",
            "function": {"description": "Loads the current process design's top-level process_steps list. Takes no meaningful arguments."},
            "class": "subprocess_tool.LoadProcessStepsCodedTool"
        },
        {
            "name": "save_subprocess_flow",
            "function": {
                "description": "Persists a generated subprocess flow for one top-level process step.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "step_name": {"type": "string", "description": "The parent process step's step_name."},
                        "subprocess_flow": {"type": "object", "description": "{\"step_name\": ..., \"subprocess_flow\": [<sub-step objects>]}"}
                    },
                    "required": ["step_name", "subprocess_flow"]
                }
            },
            "class": "subprocess_tool.SaveSubprocessFlowCodedTool"
        },
        {
            "name": "generate_process_flow_diagram",
            "function": {"description": "Infers and renders a swimlane flow diagram from the current process design. Takes no meaningful arguments."},
            "class": "edge_inference_tool.GenerateProcessFlowDiagramCodedTool"
        },
        {
            "name": "generate_process_document",
            "function": {
                "description": "Generates a structured, ISO-formatted Word document from the current process design.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "process_name": {"type": "string", "description": "Fallback document title, used only if the design JSON itself has no process_name."}
                    },
                    "required": ["process_name"]
                }
            },
            "class": "doc_generation_tool.GenerateProcessDocumentCodedTool"
        }
    ]
}

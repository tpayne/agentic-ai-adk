# Developed in tandem with samples/GCP/ProcessEngineering's own Requirements_Doc_Pipeline
# (process_agents/common/requirements_synthesis_agent.py +
# process_agents/common/requirements_reviewer_agent.py +
# process_agents/common/requirements_doc_pipeline_agent.py). CREATION
# counterpart to requirements_summary.hocon: synthesizes a brand-new
# requirements register directly from the user's own description of a
# product/system/initiative (plus general domain/regulatory knowledge),
# audits and enriches it in an iterative review loop against ISO/IEC/IEEE 29148
# standards and the project GOAL, and renders it as the final ISO/IEC/IEEE
# 29148-style Word document once approved.
{
    include "config/llm_config.hocon",

    "metadata": {
        "description": "Synthesizes a new requirements register from a description of a product/system/initiative (plus relevant domain/regulatory standards), audits and refines it in an iterative review loop, and renders it as the final requirements document.",
        "tags": ["requirements", "process-engineering-port"],
        "sample_queries": [
            "Create a requirements document for a new drug called Laptsa, a pain relief drug being developed, based on US/UK standards, to track what it needs to comply with during development, testing, and validation."
        ]
    },

    "tools": [
        {
            "name": "Requirements_Doc_Pipeline",

            "function": {
                "description": """
I create a new requirements document for a product, system, or initiative -- from a description you
give me, from a directory of files you ask me to review, or both. I synthesize a requirements register,
audit and refine it in an iterative review loop to ensure it meets ISO 29148 quality criteria and the
overarching project GOAL, and render the final document in one call.
""",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "inquiry": {"type": "string", "description": "The user's requirements-document creation request, including the description of what it's for."}
                    },
                    "required": ["inquiry"]
                }
            },

            "instructions": """
# ROLE
You orchestrate the Requirements Document Creation and Review Loop:
1. Requirements_Synthesis_Agent synthesizes or enriches the requirements register and saves it.
2. Requirements_Reviewer_Agent audits the requirements for ISO/IEC/IEEE 29148 quality standards (unambiguous, atomic, testable, complete, consistent) and goal/deliverable satisfaction, writing feedback to its mailbox and approval status.
3. You decide whether to repeat the review cycle using loop_control.
4. Requirements_Synthesis_Agent applies feedback on any REVISION pass before re-saving.
5. Once approved or max iterations reached, render the final document using regenerate_document.
You never author, modify, or audit the requirements summary JSON yourself.

# REQUIRED SEQUENCE (every time you are invoked, for a NEW creation request)
1. Call reset_loop_state once (no commentary) -- clears stale approval/iteration state from an
   earlier request and claims the turn lock. If it returns "status": "ERROR", STOP immediately and
   report that error message verbatim.
2. Call Requirements_Synthesis_Agent, passing the user's request text verbatim as "inquiry". It builds the
   initial requirements register and saves it. If its reply indicates that no concrete description or
   source material was provided, call release_pipeline_lock_for_turn FIRST, THEN STOP immediately and
   report that reply to the user verbatim.
3. Call Requirements_Reviewer_Agent, passing the user's request text verbatim as "inquiry" (it loads
   the saved requirements summary itself to perform the quality audit).
4. Call loop_control with required={"requirements_review_status": "APPROVED"} and max_iterations=2.
   - If "verdict" is "CONTINUE": call Requirements_Synthesis_Agent again, passing "inquiry" verbatim -- it will
     pick up the reviewer's feedback itself via load_iteration_feedback, apply the required enrichments,
     and re-save the requirements summary. Then go back to step 3.
   - If "verdict" is "STOP": call release_pipeline_lock_for_turn FIRST, then proceed to step 5.
5. Call regenerate_document with schema_type="requirements" and process_name set to the product/system/initiative title.
   - If its result starts with "ERROR", report that error plainly and stop.
   - If it starts with "SUCCESS", proceed to step 6.
6. Call format_review_status_summary (no arguments) to retrieve the final audit verdict.
7. Report the completed requirements document summary to the user: grouped requirements overview,
   standards/frameworks applied, document generation path, and the review audit outcome.
""",
            "tools": [
                "reset_loop_state",
                "release_pipeline_lock_for_turn",
                "Requirements_Synthesis_Agent",
                "Requirements_Reviewer_Agent",
                "loop_control",
                "regenerate_document",
                "format_review_status_summary"
            ],
            "middleware": ${pipeline_middleware}
        },

        {
            "name": "Requirements_Synthesis_Agent",

            "function": {
                "description": "Synthesizes or enriches a requirements register from the user description or directory, addressing reviewer feedback on revision passes, and persists the requirements summary.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "inquiry": {"type": "string", "description": "The user's requirements request."}
                    },
                    "required": ["inquiry"]
                }
            },

            "instructions": """
# ROLE
You are a Senior Requirements Analyst performing CREATION or ENRICHMENT. In the common case this means
synthesis from the user's own inline description of a product, system, or initiative, reasoning from
that description plus your own general knowledge of relevant industry/regulatory standards for the
stated domain. When in revision mode, you apply reviewer feedback to refine and complete the register.

# REVISION MODE (REVIEW FEEDBACK)
First, call load_iteration_feedback with channel="requirements_reviewer".
If it returns feedback containing issues:
- Call load_requirements_summary to load the current requirements summary baseline.
- Systematically address EVERY issue listed by the reviewer:
  * Remove ambiguities and replace vague qualitative terms with concrete, measurable criteria.
  * Split compound requirements into singular, atomic register entries.
  * Ensure every requirement has concrete, verifiable acceptance_criteria.
  * Ensure full coverage of all phases, deliverables, constraints, and scope specified in the user request.
  * Ensure alignment with the core project GOAL.
- Call save_requirements_summary with the enriched summary JSON.
- Report the specific enrichments made and stop.

# STEP 0: DIRECTORY CONTEXT (WHENEVER THE REQUEST REFERENCES ONE)
If "inquiry" asks you to read/scan/review/analyze the files in a directory or folder, call your
load_directory_context tool with that directory path as your first action. If the tool returns
"status": "NOT_FOUND", and "inquiry" ALSO gave an inline description, proceed using only that
description; if "inquiry" gave NO inline description either, ask for clarification.

# STEP 0B: DETERMINE MODE
- GROUNDED EXTRACTION MODE: a directory was read AND "inquiry" gives no separate inline description.
- SYNTHESIS MODE (default): an inline description was given -- reason from the description plus
  well-established domain/regulatory knowledge.

# STEP 0C: MULTI-CHUNK EXTRACTION (GROUNDED EXTRACTION MODE ONLY, "chunk_count" > 1)
This step applies ONLY in GROUNDED EXTRACTION MODE (STEP 0B) -- SYNTHESIS MODE always reasons from
the inline description in a single pass and never needs this, even when a directory was ALSO read
as supplementary background. In GROUNDED EXTRACTION MODE, if STEP 0's load_directory_context result
has "chunk_count" equal to 1, skip this step and proceed to STEP 1/2 using "combined_text" exactly
as before -- this is the common case for a normal-sized directory. If "chunk_count" > 1, call
Requirements_Chunk_Extractor_Agent for each chunk, then merge extractions.

# STEP 1: CHECK FOR SOMETHING CONCRETE TO REASON ABOUT
If you have neither a directory nor an inline description, reply asking for details and STOP.

# STEP 2: SYNTHESIZE THE REQUIREMENTS SUMMARY
Internally generate a single JSON object:
- name: a short, SPECIFIC title (e.g. "Laptsa Pain Relief Drug Requirements Specification").
- source_directory: directory path or "".
- source_files: list of files or [].
- summary: prose overview (2-4 sentences).
- industry_sector: specific domain (e.g. "Pharmaceuticals", "IT Service Management").
- current_state: paragraph on as-is situation grounded in description/domain.
- future_state: paragraph on desired to-be situation.
- success_measures: list of strings (concrete measures of success).
- scope_in: list of strings (specific capabilities/activities in scope).
- scope_out: list of strings (specific exclusions).
- stakeholders: list of roles/parties implied by the description and domain.
- assumptions: list of plain strings.
- risks: list of plain strings.
- open_questions: list of plain strings.

# STEP 2A: THE REQUIREMENTS REGISTER (MANDATORY STRUCTURE)
Every atomic requirement/goal/constraint goes into "requirements_register":
```
requirements_register: [
  {
    "id": "FR-001" | "NFR-001" | "GOAL-001" | "CON-001",
    "type": "functional" | "non_functional" | "goal" | "constraint",
    "description": "<the requirement/goal/constraint text>",
    "source": "<specific standard, framework, or request source>",
    "acceptance_criteria": ["<concrete, verifiable statement of how to confirm this is met>", ...],
    "status": "proposed",
    "priority": "critical" | "high" | "medium" | "low" (optional),
    "owner": "<a role from stakeholders>" (optional),
    "confidence": "high" | "medium" | "low" (optional),
    "verification_method": "Test" | "Inspection" | "Analysis" | "Demonstration" (optional),
    "traces_to": ["<other register id(s) this requirement satisfies>"] (optional)
  },
  ...
]
```

# STEP 2B-2E: QUALITY PASS, INFERRED REQUIREMENTS, COVERAGE GAPS, DEPENDENCIES, GLOSSARY
Populate:
- requirement_priorities: list of {"requirement_id", "requirement_text", "priority", "rationale"}.
- conflicting_requirements: list of {"requirement_ids", "requirements_text", "description", "recommendation"}.
- requirements_needing_clarification: list of {"requirement_id", "requirement_text", "question"}.
- inferred_requirements: list of {"id", "requirement", "rationale", "category", "derived_from", "acceptance_criteria"}.
- coverage_gaps: list of {"category", "description"}.
- dependencies: list of {"dependency", "description", "status": "Confirmed"|"Unconfirmed"|"At Risk"|""}.
- glossary: list of {"term", "definition"}.

# STEP 2F: SELF-CHECK BEFORE SAVING
1. Scope Check: ensure bullets are specific, not generic noun phrases.
2. Risks Check: verify every conflicting requirement has a corresponding risk.
3. Type Check: ensure assumptions, risks, and open_questions are plain strings.

# STEP 3: SAVE THE SUMMARY (MANDATORY)
Call save_requirements_summary with the completed JSON object. Report what was synthesized.
""",
            "tools": [
                "load_directory_context",
                "load_requirements_summary",
                "save_requirements_summary",
                "load_iteration_feedback",
                "/requirements_chunk_extractor"
            ]
        },

        {
            "name": "Requirements_Reviewer_Agent",

            "function": {
                "description": "Audits the quality and goal satisfaction of the saved requirements summary against ISO/IEC/IEEE 29148 criteria, writing feedback to iteration_feedback.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "inquiry": {"type": "string", "description": "The user's request, passed through for context."}
                    },
                    "required": ["inquiry"]
                }
            },

            "instructions": """
# ROLE
You are a Principal Requirements Quality Auditor performing a QUALITY AUDIT against ISO/IEC/IEEE 29148
standards and project GOAL satisfaction on the saved requirements summary.

# CRITICAL OPERATIONAL RULES
1. Call load_requirements_summary. Reload it every turn.
2. Audit ONLY what is actually present in the requirements summary.
3. Universal domain-agnostic principles: never hardcode assumptions based on any specific sample prompt.
   Evaluate dynamically against the user's stated goals, scope, deliverables, and standards.

# AUDIT CRITERIA (ISO/IEC/IEEE 29148 + GOAL SATISFACTION)
1. NECESSARY: Does each requirement serve a real stated need or goal?
2. UNAMBIGUOUS: Are terms precise, avoiding vague qualifiers ("fast", "user-friendly", "modern")?
3. COMPLETE: Does each requirement stand on its own with clear context?
4. SINGULAR / ATOMIC: No compound requirements bundling multiple distinct functions into one.
5. FEASIBLE: Technically and operationally plausible given constraints.
6. VERIFIABLE / TESTABLE: Each requirement must specify 1 or more concrete, verifiable acceptance_criteria.
7. CONSISTENT: No internal contradictions or unhandled duplicate requirements.
8. GOAL & DELIVERABLE SATISFACTION:
   - Verify that all phases, deliverables, scope items, and constraints requested by the user are
     explicitly represented in the requirements register (FR, NFR, GOAL, CON).
   - If vendor/tool options are being evaluated, ensure requirements demand neutral, objective criteria.

# AUDIT OUTCOME & FEEDBACK CONTRACT
1. IF ANY CRITERIA FAIL:
   - Compile a structured list of specific defects and actionable instructions:
     `[{"issue": "<detailed issue description>", "instruction": "<exact instruction on how to refine/enrich>"}]`
   - CALL save_iteration_feedback with:
     `feedback_data={"status": "REVISION REQUIRED", "data": issues_list}`
     `channel="requirements_reviewer"`
   - Output a clear summary of findings explaining why revision is required.
2. IF ALL CRITERIA PASS:
   - CALL save_iteration_feedback with:
     `feedback_data={"status": "REQUIREMENTS_REVIEW_APPROVED", "data": []}`
     `channel="requirements_reviewer"`
   - Output: "REQUIREMENTS_REVIEW_APPROVED: Requirements register satisfies all ISO 29148 quality criteria and core project goals."
""",
            "tools": [
                "load_requirements_summary",
                "save_iteration_feedback"
            ]
        },

        {
            "name": "reset_loop_state",
            "function": {"description": "Clears stale approval/iteration-counter state from an earlier request and claims pipeline lock. Takes no meaningful arguments."},
            "class": "reset_loop_state_tool.ResetLoopStateCodedTool"
        },
        {
            "name": "release_pipeline_lock_for_turn",
            "function": {"description": "Safely releases THIS turn's own pipeline lock. Takes no meaningful arguments."},
            "class": "release_pipeline_lock_tool.ReleasePipelineLockForTurnCodedTool"
        },
        {
            "name": "loop_control",
            "function": {
                "description": "Decides whether the generate/review loop should continue or stop.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "required": {"type": "object", "description": "Approval-state keys/values that must all be present to stop as approved."},
                        "max_iterations": {"type": "integer"}
                    },
                    "required": ["required", "max_iterations"]
                }
            },
            "class": "loop_control_tool.LoopControlCodedTool"
        },
        {
            "name": "load_iteration_feedback",
            "function": {
                "description": "Reads and drains a feedback mailbox channel.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "channel": {"type": "string", "description": "Which mailbox channel to read, e.g. \"requirements_reviewer\"."}
                    },
                    "required": ["channel"]
                }
            },
            "class": "load_iteration_feedback_tool.LoadIterationFeedbackCodedTool"
        },
        {
            "name": "save_iteration_feedback",
            "function": {
                "description": "Writes feedback and approval status to an iteration feedback channel.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "feedback_data": {"type": "object", "description": "Object with status and data list."},
                        "channel": {"type": "string", "description": "Channel name, e.g. \"requirements_reviewer\"."}
                    },
                    "required": ["feedback_data", "channel"]
                }
            },
            "class": "save_iteration_feedback_tool.SaveIterationFeedbackCodedTool"
        },
        {
            "name": "format_review_status_summary",
            "function": {"description": "Renders the current review status summary for requirements review."},
            "class": "format_review_status_tool.FormatReviewStatusCodedTool"
        },
        {
            "name": "load_directory_context",
            "function": {
                "description": "Reads every supported file directly inside a directory and returns their combined extracted text.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "directory": {
                            "type": "string",
                            "description": "Path to the directory to read."
                        }
                    },
                    "required": ["directory"]
                }
            },
            "class": "load_directory_context_tool.LoadDirectoryContextCodedTool"
        },
        {
            "name": "load_requirements_summary",
            "function": {
                "description": "Loads the most recently saved requirements summary, if any. Takes no meaningful arguments."
            },
            "class": "load_requirements_summary_tool.LoadRequirementsSummaryCodedTool"
        },
        {
            "name": "save_requirements_summary",
            "function": {
                "description": "Persists the synthesized requirements summary JSON so the next step can render it.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "summary": {
                            "type": "object",
                            "description": "The full requirements summary JSON object."
                        }
                    },
                    "required": ["summary"]
                }
            },
            "class": "save_requirements_summary_tool.SaveRequirementsSummaryCodedTool"
        },
        {
            "name": "regenerate_document",
            "function": {
                "description": "Renders the final Word document from whatever requirements summary is saved on disk.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "schema_type": {
                            "type": "string",
                            "enum": ["requirements"],
                            "description": "Always \"requirements\" for this pipeline."
                        },
                        "process_name": {
                            "type": "string",
                            "description": "Fallback document title, used only if the saved requirements_summary.json has no \"name\" field of its own."
                        }
                    },
                    "required": ["schema_type", "process_name"]
                }
            },
            "class": "doc_generation_tool.RegenerateDocumentCodedTool"
        }
    ]
}

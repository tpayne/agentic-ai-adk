{
    "llm_config": {
        "model_name": "gemini-3-flash",
        #"model_name": "gpt-6-luna"
        # OpenAI reasoning models such as gpt-6-luna reject function tools on
        # Chat Completions while reasoning is enabled. Use Responses API so
        # those models retain reasoning and can still call this project's tools.
        # Other providers ignore this OpenAI-specific option.
        "use_responses_api": true
    },

    # neuro-san's own default (RunContextRunnable.run_it) is 300 seconds per
    # agent -- too short for this project's generate/review pipelines
    # (process/process_update/design/design_update: analysis -> design ->
    # compliance -> simulation, looped up to 2x, plus process's
    # Subprocess_Driver_Agent making one further LLM call per top-level
    # step) and for process_architect, whose own budget wraps the entire
    # call chain into whichever pipeline it routes to. Every network
    # includes this file, so raising it here covers all of them in one
    # place rather than repeating a per-network override.
    "max_execution_seconds": 3600

    # A pipeline front-man (process/process_update/design/design_update/
    # cloudarch) calls several of its own tools in sequence within ONE
    # turn -- reset_loop_state, then generator/reviewer agents, then
    # loop_control, repeated up to the pipeline's own max_iterations --
    # and each call+result pair is appended to THAT AGENT's own chat
    # history. Nothing here reads prior turns back out of that history
    # (every stage re-reads its real state from disk instead -- see
    # README.md's "neuro-san implementation notes"), so it's safe to let
    # neuro-san's own summarization middleware condense older messages
    # once a front-man's own history crosses this threshold, keeping only
    # the most recent few for continuity -- the direct equivalent of the
    # ADK original's events_compaction_config (same token-threshold-based
    # trigger, same "safe because nothing re-reads old history" reasoning
    # -- see the ADK sample's own agent.py for that original comment).
    # Defined once here, referenced via ${pipeline_middleware} on each of
    # the five pipeline front-men below.
    "pipeline_middleware": [
        {
            "class": "neuro_san.middleware.neuro_san_summarization_middleware.NeuroSanSummarizationMiddleware",
            "args": {
                # The middleware creates its own LangChain model; it does not
                # inherit llm_config.model_name. Keep its provider aligned with
                # the OpenAI model used by the agent networks so running with
                # OPENAI_API_KEY does not unexpectedly require GOOGLE_API_KEY.
                "model": "openai:gpt-6-luna",
                "trigger": [["tokens", 150000]],
                "keep": ["messages", 8],
                "keep_summary_in_context": true,
                "chat_history": true,
            }
        }
    ]
}

{
    "llm_config": {
        "model_name": "gemini-3-flash",
        #"model_name": "gpt-6-luna"
        # OpenAI reasoning models such as gpt-6-luna reject function tools on
        # Chat Completions while reasoning is enabled. Use Responses API so
        # those models retain reasoning and can still call this project's tools.
        # Other providers ignore this OpenAI-specific option.
        "use_responses_api": true

        # ---------------------------------------------------------------------------
        # LOCAL OLLAMA (no API key required — Ollama must be running locally)
        # Use "ollama_chat/" for chat/tool-calling models (recommended).
        # Use "ollama/" for text-generation or embedding models.
        # Requires: Ollama running at http://localhost:11434 (default).
        # Pull your model first: `ollama pull llama3.2`
        # Set OLLAMA_BASE_URL to override the default endpoint, e.g.:
        #   export OLLAMA_BASE_URL="http://localhost:11434"
        # ---------------------------------------------------------------------------
        #"model_name": "ollama_chat/llama3.2"
        #"model_name": "ollama_chat/mistral"
        #"model_name": "ollama_chat/qwen2.5:7b"
        #"model_name": "ollama/llama3.2"           # generation/embeddings endpoint

        # ---------------------------------------------------------------------------
        # OPENROUTER (cloud-hosted, 300+ models from many providers)
        # Requires: OPENROUTER_API_KEY environment variable.
        #   export OPENROUTER_API_KEY="sk-or-v1-..."
        # Model format: "openrouter/<provider>/<model>"
        # Browse available models at https://openrouter.ai/models
        # ---------------------------------------------------------------------------
        #"model_name": "openrouter/openai/gpt-4o"
        #"model_name": "openrouter/anthropic/claude-sonnet-4-5"
        #"model_name": "openrouter/meta-llama/llama-3.1-8b-instruct"
        #"model_name": "openrouter/google/gemini-flash-1.5"
    },

    # neuro-san's own default (RunContextRunnable.run_it) is 300 seconds per
    # agent -- too short for this project's generate/review pipelines
    # (process/process_update/design/design_update: analysis -> design ->
    # compliance -> simulation, looped up to 2x, plus process's
    # Subprocess_Driver_Agent making one further LLM call per top-level
    # step) and for process_architect, whose own budget wraps the entire
    # call chain into whichever pipeline it routes to. Every network
    # includes this file, so raising it here covers all of them in one
    # place rather than repeating a per-network override.
    "max_execution_seconds": 3600

    # A pipeline front-man (process/process_update/design/design_update/
    # cloudarch) calls several of its own tools in sequence within ONE
    # turn -- reset_loop_state, then generator/reviewer agents, then
    # loop_control, repeated up to the pipeline's own max_iterations --
    # and each call+result pair is appended to THAT AGENT's own chat
    # history. Nothing here reads prior turns back out of that history
    # (every stage re-reads its real state from disk instead -- see
    # README.md's "neuro-san implementation notes"), so it's safe to let
    # neuro-san's own summarization middleware condense older messages
    # once a front-man's own history crosses this threshold, keeping only
    # the most recent few for continuity -- the direct equivalent of the
    # ADK port's events_compaction_config (same token-threshold-based
    # trigger, same "safe because nothing re-reads old history" reasoning
    # -- see the ADK sample's own agent.py for that original comment).
    # Defined once here, referenced via ${pipeline_middleware} on each of
    # the five pipeline front-men below.
    "pipeline_middleware": [
        {
            "class": "neuro_san.middleware.neuro_san_summarization_middleware.NeuroSanSummarizationMiddleware",
            "args": {
                # The middleware creates its own LangChain model via
                # init_chat_model("<provider>:<model>"); it does NOT inherit
                # llm_config.model_name above, so this must be kept in sync
                # BY HAND with whichever "model_name" line is actually
                # uncommented there (see this file's own README section --
                # "when changing providers, update that middleware model and
                # provide its matching API key as well"). The "google_genai:"
                # prefix itself is required -- LangChain's init_chat_model()
                # otherwise infers a bare "gemini-..." name as
                # model_provider="google_vertexai" by default and fails
                # importing a package this project doesn't install
                # (langchain-google-vertexai), even though llm_config.hocon's
                # "gemini-3-flash" model actually goes through the Gemini
                # Developer API / GOOGLE_API_KEY, i.e. "google_genai".
                #
                # CONFIRMED AS A REAL PRODUCTION BUG: this had drifted to
                # "openai:gpt-6-luna" (correct only while model_name above
                # was ALSO an OpenAI model) while model_name had since moved
                # to "gemini-3-flash" above, with nothing to catch the
                # mismatch -- anyone running Gemini-only (no OPENAI_API_KEY
                # set, since nothing else in this project ever needs one)
                # would have this middleware's OWN background summarization
                # call fail the moment any single turn's conversation crossed
                # the 150,000-token trigger below, with no visible error at
                # all (a third-party LangChain/neuro-san class, not one of
                # this project's own loggers -- see logging_setup.py's own
                # _NOISY_THIRD_PARTY_LOGGER_NAMES, which does not cover this
                # one) -- manifesting as an unexplained multi-minute freeze
                # on exactly the kind of large, multi-agent exchange (TOGAF's
                # compliance loop chained after a large design JSON load, in
                # particular) likely to cross that threshold within one turn.
                "model": "google_genai:gemini-3-flash",
                "trigger": [["tokens", 150000]],
                "keep": ["messages", 8],
                "keep_summary_in_context": true,
                "chat_history": true,
            }
        }
    ]
}

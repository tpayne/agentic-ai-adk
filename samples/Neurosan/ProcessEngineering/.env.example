# Single Sign-On (SSO) OAuth Credentials for Real Provider APIs
#
# Register a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:8081 (or your webclient URL)
# - Authorization callback URL: http://localhost:8081/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Register a Google OAuth 2.0 Web Client in Google Cloud Console:
# - Authorized redirect URI: http://localhost:8081/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Register a Microsoft / Azure App in Microsoft Entra admin center:
# - Redirect URI (Web): http://localhost:8081/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Outlook (can use Microsoft credentials above or dedicated app)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# If your web client is served from a different origin than this backend,
# /auth/login's own ?redirect_uri= needs an explicit allowlist of trusted
# origins to safely redirect back to after login -- otherwise it falls back
# to a same-origin relative path only. Comma-separated, no trailing slash.
# SSO_ALLOWED_REDIRECT_ORIGINS=https://my-webclient.example

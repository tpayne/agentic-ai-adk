  "required": [
    "document_metadata"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "document_metadata": {
            "properties": {
              "document_type": {
                "const": "HLD"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "high_level_design"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "document_metadata": {
            "properties": {
              "document_type": {
                "const": "LLD"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "low_level_design"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "document_metadata": {
            "properties": {
              "document_type": {
                "const": "Combined"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "high_level_design",
          "low_level_design"
        ]
      }
    }
  ],
  "additionalProperties": false
}
